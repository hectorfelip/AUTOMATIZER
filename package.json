{
  "name": "automation-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Automation Studio — automações visuais para Windows",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm exec -w @automation-studio/desktop -- install-electron",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:py": "python -m pytest engine/python",
    "test:e2e": "npm run build && npm run test:e2e -w @automation-studio/desktop",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:py"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
