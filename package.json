{
  "name": "automation-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Automation Studio — automações visuais para Windows",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:py": "python -m pytest engine/python",
    "check": "npm run lint && npm run build && npm test && npm run test:py"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
