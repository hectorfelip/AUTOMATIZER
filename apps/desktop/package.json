    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5",
    "electron": "45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^7"
  },
  "dependencies": {
    "@automation-studio/node-registry": "^0.0.0",
    "@automation-studio/shared-types": "^0.0.0",
    "@automation-studio/workflow-interpreter": "*",
    "@automation-studio/workflow-schema": "^0.0.0",
    "@automation-studio/workflow-validator": "^0.0.0",
    "@xyflow/react": "^13.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
